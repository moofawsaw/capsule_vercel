{
  "rewrites": [
    { "source": "/apple-app-site-association", "destination": "/.well-known/apple-app-site-association" },
    {
      "source": "/u/:storyId([A-Za-z0-9-]+)",
      "destination": "https://resdvutqgrbbylknaxjp.supabase.co/functions/v1/story-share-page/u/:storyId"
    },
    { "source": "/story/:storyId([A-Za-z0-9-]+)", "destination": "/api/:storyId" },
    { "source": "/join/:type/:code", "destination": "/api/join/:type/:code" },
    {
      "source": "/:storyId([A-Za-z0-9-]+)",
      "destination": "https://resdvutqgrbbylknaxjp.supabase.co/functions/v1/story-share-page/u/:storyId"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        { "key": "Content-Type", "value": "image/x-icon" },
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/apple-touch-icon.png",
      "headers": [
        { "key": "Content-Type", "value": "image/png" },
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/favicon-32x32.png",
      "headers": [
        { "key": "Content-Type", "value": "image/png" },
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/favicon-16x16.png",
      "headers": [
        { "key": "Content-Type", "value": "image/png" },
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/logo_share.png",
      "headers": [
        { "key": "Content-Type", "value": "image/png" },
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
      ]
    }
  ]
}
